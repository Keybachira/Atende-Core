FROM node:22-alpine AS base
RUN npm i -g pnpm@12.6.0
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/desktop/package.json apps/desktop/
COPY packages/auth/package.json packages/auth/
COPY packages/automation/package.json packages/automation/
COPY packages/config/package.json packages/config/
COPY packages/crm/package.json packages/crm/
COPY packages/database/package.json packages/database/
COPY packages/messaging/package.json packages/messaging/
COPY packages/pipeline/package.json packages/pipeline/
COPY packages/queue/package.json packages/queue/
COPY packages/schemas/package.json packages/schemas/
COPY packages/shared/package.json packages/shared/
COPY packages/ui/package.json packages/ui/
RUN pnpm install --no-frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm --filter @atende/database db:generate \
  && pnpm --filter @atende/shared --filter @atende/config --filter @atende/crm --filter @atende/messaging --filter @atende/pipeline --filter @atende/queue --filter @atende/automation build \
  && pnpm --filter @atende/api build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/apps/api/dist ./apps/api/dist
COPY --from=build /app/apps/api/package.json ./apps/api/
COPY --from=build /app/packages ./packages
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/database/prisma ./packages/database/prisma
EXPOSE 3001
CMD ["node", "apps/api/dist/main.js"]
